# ============================================================
# 702platform 部署配置模板
#
# 用法:
#   1) cp deploy/env.template env.sh
#   2) 编辑 env.sh，把每个 <尖括号> 占位符替换成真实值
#   3) 运行首次部署脚本: ./deploy/install.sh
#
# 约定:
#   <...>   尖括号 = 系统信息/机密信息，必须由部署者填写，
#           install.sh 发现仍有占位符会打印提示并中止。
#           其他项是本应用信息，已给默认值，一般无需改动。
# ============================================================

# ---------- 应用服务（本应用信息，端口默认值） ----------
# 应用进程监听地址和端口（Nginx 反代目标）
DJANGO_APP_HOST=127.0.0.1
DJANGO_APP_PORT=8000

# Django 密钥 / 调试 / 允许主机（机密必须填写）
DJANGO_SECRET_KEY=<SECRET_KEY>
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=<DOMAIN_OR_IP>,127.0.0.1

# ---------- 数据库（PostgreSQL；名称/用户/密码必须填写） ----------
DJANGO_DB_NAME=<DB_NAME>
DJANGO_DB_USER=<DB_USER>
DJANGO_DB_PASSWORD=<DB_PASSWORD>
# PostgreSQL 服务地址端口（本应用信息，默认值）
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432

# ---------- HTTPS / Cookie ----------
# 两个 Secure 标志默认就是 1（站点全程 https，IP 直连也适用）。只有在纯 http
# 环境里才需要显式改 0，否则浏览器不会带上会话 Cookie，谁都登录不了。
DJANGO_SESSION_COOKIE_SECURE=1
DJANGO_CSRF_COOKIE_SECURE=1
# TLS 由谁终结：由 Nginx 或上层代理终结时设 1，让 Django 认得 https。
DJANGO_PROXY_SSL_HEADER=0
# 拿到本平台自己的证书后再开（逗号分隔，需带协议）:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<DOMAIN_OR_IP>

# 整站跳 https。默认关：当前证书借自另一个站点，且有人用 http://IP 直接访问，
# 硬跳会把 IP 入口打到那个域名上去。拿到自己的证书后设 1。
DJANGO_SECURE_SSL_REDIRECT=0
# HSTS 有效期（秒）。**默认 0（关闭），不要轻易改。** HSTS 生效期间浏览器会拒绝
# 一切非 https 访问且用户无法绕过；证书是借来的情况下，证书一被收回站点就锁死了。
# 拿到自己稳定的证书后再考虑，初值建议 60，确认无误再逐步加长。
DJANGO_SECURE_HSTS_SECONDS=0

# ---------- 超级管理员（首次部署自动创建；用户名/邮箱/密码必须填写） ----------
DJANGO_SUPERUSER_USERNAME=<ADMIN_USERNAME>
DJANGO_SUPERUSER_EMAIL=<ADMIN_EMAIL>
DJANGO_SUPERUSER_PASSWORD=<ADMIN_PASSWORD>

# ---------- 数据库备份频次（systemd OnCalendar 语法） ----------
# 默认每天 02:30。示例:
#   每天      -> daily          (= *-*-* 00:00:00)
#   每天3点   -> *-*-* 03:00:00
#   周一到五2点-> Mon..Fri *-*-* 02:00:00
#   每小时    -> hourly
DJANGO_BACKUP_SCHEDULE=daily
# 备份保留份数（默认 14 份）
DJANGO_BACKUP_RETAIN=14

# ---------- 部署目标信息（必须填写） ----------
# 对外域名与公网 IP：Nginx server_name 使用这两个值（也都应写入 DJANGO_ALLOWED_HOSTS）
DEPLOY_DOMAIN=<DOMAIN>
DEPLOY_PUBLIC_IP=<PUBLIC_IP>
# 可选 HTTPS（Nginx 终止 TLS，监听 443）：填入证书与私钥路径则启用；留空则仅监听 HTTP 80
# （证书参考 Certbot/Let's Encrypt；路径须与服务器实际存在一致）
SSL_CERT_PATH=
SSL_KEY_PATH=
# 运行服务与备份的 Linux 系统用户（必须是你服务器上的真实用户）
DEPLOY_SYSTEM_USER=<DEPLOY_USER>