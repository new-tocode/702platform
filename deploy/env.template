# ============================================================
# 702platform 部署配置模板
#
# 用法:
#   1) cp deploy/env.template env.sh
#   2) 编辑 env.sh，把每个 <尖括号> 占位符替换成真实值
#   3) 运行首次部署脚本: ./deploy/install.sh
#
# 约定:
#   <...>   尖括号 = 系统信息/机密信息，必须由部署者填写，
#           install.sh 发现仍有占位符会打印提示并中止。
#           其他项是本应用信息，已给默认值，一般无需改动。
# ============================================================

# ---------- 应用服务（本应用信息，端口默认值） ----------
# 应用进程监听地址和端口（Nginx 反代目标）
DJANGO_APP_HOST=127.0.0.1
DJANGO_APP_PORT=8000

# Django 密钥 / 调试 / 允许主机（机密必须填写）
DJANGO_SECRET_KEY=<SECRET_KEY>
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=<DOMAIN_OR_IP>

# ---------- 数据库（默认 PostgreSQL；名称/用户/密码必须填写） ----------
DJANGO_DB_ENGINE=django.db.backends.postgresql
DJANGO_DB_NAME=<DB_NAME>
DJANGO_DB_USER=<DB_USER>
DJANGO_DB_PASSWORD=<DB_PASSWORD>
# PostgreSQL 服务地址端口（本应用信息，默认值）
DJANGO_DB_HOST=127.0.0.1
DJANGO_DB_PORT=5432

# ---------- HTTPS（默认 HTTP；启用 HTTPS 且由 Nginx 终止 TLS 时改下面三项） ----------
DJANGO_SESSION_COOKIE_SECURE=0
DJANGO_CSRF_COOKIE_SECURE=0
DJANGO_PROXY_SSL_HEADER=0
# 启用 HTTPS 后设置（逗号分隔，需带协议）:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://<DOMAIN_OR_IP>

# ---------- 超级管理员（首次部署自动创建；用户名/邮箱/密码必须填写） ----------
DJANGO_SUPERUSER_USERNAME=<ADMIN_USERNAME>
DJANGO_SUPERUSER_EMAIL=<ADMIN_EMAIL>
DJANGO_SUPERUSER_PASSWORD=<ADMIN_PASSWORD>

# ---------- 数据库备份频次（systemd OnCalendar 语法） ----------
# 默认每天 02:30。示例:
#   每天      -> daily          (= *-*-* 00:00:00)
#   每天3点   -> *-*-* 03:00:00
#   周一到五2点-> Mon..Fri *-*-* 02:00:00
#   每小时    -> hourly
DJANGO_BACKUP_SCHEDULE=daily
# 备份保留份数（默认 14 份）
DJANGO_BACKUP_RETAIN=14

# ---------- 部署目标信息（必须填写） ----------
# Nginx server_name（域名或 IP，用来生成站点配置并做健康检查）
DEPLOY_SERVER_NAME=<DOMAIN_OR_IP>
# 运行服务与备份的 Linux 系统用户（必须是你服务器上的真实用户）
DEPLOY_SYSTEM_USER=<DEPLOY_USER>