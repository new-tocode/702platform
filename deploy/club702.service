[Unit]
Description=Competition club platform (gunicorn)
After=network.target @@PG_SERVICE@@

[Service]
Type=notify
User=@@APP_USER@@
Group=@@APP_USER@@
WorkingDirectory=@@APP_DIR@@
EnvironmentFile=@@APP_DIR@@/env.sh
ExecStart=@@VENV@@/bin/gunicorn config.wsgi:application \
    --bind @@APP_HOST@@:@@APP_PORT@@ \
    --workers 3 \
    --timeout 120 \
    --access-logfile - \
    --error-logfile -
Restart=on-failure
RestartSec=3
# 进程加固
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=@@APP_DIR@@

[Install]
WantedBy=multi-user.target